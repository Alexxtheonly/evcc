index 0000000..f9e8cca
--- /dev/null
+++ b/src/optimizer/energy_extension.py
@@ -0,0 +1,113 @@
+"""Validation for the local energy planning API."""
+
+import math
+
+CAPABILITIES = {
+    'version': 1,
+    'features': ['battery_availability', 'battery_efficiency', 'battery_wear', 'fixed_first_step'],
+}
+MAX_SLOTS = 384
+MAX_BATTERIES = 16
+
+
+def finite(value, name: str, minimum=None, maximum=None) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise ValueError(f'{name} must be finite')
+    if minimum is not None and value < minimum:
+        raise ValueError(f'{name} must be at least {minimum}')
+    if maximum is not None and value > maximum:
+        raise ValueError(f'{name} must be at most {maximum}')
+    return value
+
+
+def efficiency(value, name: str) -> float:
+    value = finite(value, name, 0, 1)
+    if value == 0:
+        raise ValueError(f'{name} must be positive')
+    return value
+
+
+def bounded_energy(value, name: str, maximum: float) -> float:
+    value = finite(value, name, 0)
+    finite(maximum, name + ' limit', 0)
+    # Normalize only arithmetic roundoff, never solver/float32 output precision.
+    tolerance = min(4 * math.ulp(maximum), 1e-9) if maximum > 0 else 0
+    if value > maximum and value - maximum > tolerance:
+        raise ValueError(f'{name} must be at most {maximum}')
+    return min(value, maximum)
+
+
+def validate_input(data: dict) -> None:
+    series = data['time_series']
+    count = len(series['dt'])
+    if not 1 <= count <= MAX_SLOTS:
+        raise ValueError(f'horizon must contain 1 to {MAX_SLOTS} slots')
+    if not 1 <= len(data['batteries']) <= MAX_BATTERIES:
+        raise ValueError(f'input must contain 1 to {MAX_BATTERIES} batteries')
+    for key in ('dt', 'gt', 'ft', 'p_N', 'p_E'):
+        if len(series[key]) != count:
+            raise ValueError(f'{key} length must match dt')
+        for value in series[key]:
+            finite(value, key, 0 if key in ('dt', 'gt', 'ft') else None)
+            if key == 'dt' and value == 0:
+                raise ValueError('dt must be positive')
+    eta_c = efficiency(data.get('eta_c', 0.95), 'eta_c')
+    eta_d = efficiency(data.get('eta_d', 0.95), 'eta_d')
+    for key, value in data.get('grid', {}).items():
+        if key in ('p_max_imp', 'p_max_exp', 'prc_p_exc_imp') and value is not None:
+            finite(value, key, 0)
+    for battery in data['batteries']:
+        validate_battery(battery, series['dt'], eta_c, eta_d)
+
+
+def validate_battery(battery: dict, durations: list, default_eta_c: float, default_eta_d: float) -> None:
+    for key in ('s_min', 's_max', 's_initial', 'c_min', 'c_max', 'd_max'):
+        finite(battery[key], key, 0)
+    finite(battery['p_a'], 'p_a')
+    capacity = finite(battery.get('s_capacity', battery['s_max']), 's_capacity', 0)
+    if not battery['s_min'] <= battery['s_max'] <= capacity or battery['s_initial'] > capacity:
+        raise ValueError('storage bounds or initial energy exceed capacity')
+    if battery['c_min'] > battery['c_max']:
+        raise ValueError('c_min exceeds c_max')
+    count = len(durations)
+    for key in ('s_goal', 'p_demand'):
+        if battery.get(key) is not None:
+            if len(battery[key]) != count:
+                raise ValueError(f'{key} length must match dt')
+            for value in battery[key]:
+                finite(value, key, 0)
+    availability = battery.get('availability')
+    if availability is not None:
+        if len(availability) != count or any(type(value) is not bool for value in availability):
+            raise ValueError('availability must contain one boolean per slot')
+    eta_c = efficiency(battery.get('eta_c', default_eta_c), 'battery eta_c')
+    eta_d = efficiency(battery.get('eta_d', default_eta_d), 'battery eta_d')
+    finite(battery.get('wear_cost', 0), 'wear_cost', 0)
+    charge = battery.get('first_step_charge')
+    discharge = battery.get('first_step_discharge')
+    if (charge is None) != (discharge is None):
+        raise ValueError('both first_step_charge and first_step_discharge are required together')
+    if charge is None:
+        return
+    finite(charge, 'first_step_charge', 0)
+    finite(discharge, 'first_step_discharge', 0)
+    if charge > 0 and discharge > 0:
+        raise ValueError('first step cannot charge and discharge simultaneously')
+    if availability is not None and not availability[0] and charge + discharge > 0:
+        raise ValueError('first step action requires battery availability')
+    charge = bounded_energy(charge, 'first_step_charge', min(
+        battery['c_max'] * durations[0] / 3600, (capacity - battery['s_initial']) / eta_c))
+    discharge = bounded_energy(discharge, 'first_step_discharge', min(
+        battery['d_max'] * durations[0] / 3600, battery['s_initial'] * eta_d))
+    # Exact-boundary multiplication/division can still round across full/empty.
+    for _ in range(5):
+        final = battery['s_initial'] + eta_c * charge - discharge / eta_d
+        if 0 <= final <= capacity:
+            battery['first_step_charge'] = charge
+            battery['first_step_discharge'] = discharge
+            return
+        if final > capacity:
+            charge = math.nextafter(charge, 0.0)
+        else:
+            discharge = math.nextafter(discharge, 0.0)
+    raise ValueError('first step action exceeds physical storage capacity')
